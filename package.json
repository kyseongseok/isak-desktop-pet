{
  "name": "isak-desktop-pet",
  "productName": "이삭이",
  "version": "0.1.8",
  "description": "농촌진흥청 캐릭터 이삭이 데스크톱 펫 — 초과근무 근무확인 알림 도우미",
  "main": "app/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:arcade": "electron-builder --mac --arm64 --config arcade-builder.json --publish never"
  },
  "author": "kskwon",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "kr.go.rda.isak-pet",
    "productName": "IsakPet",
    "files": [
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/renderer/img/idle.png"
    },
    "mac": {
      "target": "dir",
      "icon": "app/renderer/img/idle.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "이삭이-설치-${version}.exe",
      "shortcutName": "이삭이"
    }
  }
}
